# Копирай като .env и попълни. .env НИКОГА не се качва в git.
# Ключовете стоят само тук: не ги пиши в чата, в biznes.toml или в кода.

# KIE.AI → https://kie.ai/api-key  (зареди $10 кредити)
KIE_API_KEY=

# Meta → business.facebook.com → Настройки → Системни потребители → Генерирай токен
# Права: ads_management, ads_read, pages_read_engagement, pages_manage_ads, business_management
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=
# по желание: Instagram акаунтът, свързан със страницата
META_IG_USER_ID=
